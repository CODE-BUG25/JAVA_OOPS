# Aegis Orbital - Environment Configuration Example

# Backend Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Demo Mode (Set to true to use offline frozen dataset & pre-baked conjunctions)
DEMO_MODE=false

# CelesTrak Ingestion
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_TIMEOUT_SECONDS=15
CELESTRAK_MAX_RETRIES=3

# Optional Space-Track API Credentials (Feature-flagged off if empty)
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# Conjunction Screening Engine Defaults
SCREENING_PREDICTION_WINDOW_HOURS=24.0
SCREENING_COARSE_TIMESTEP_SECONDS=60.0
SCREENING_RADIUS_KM=50.0
SCREENING_REFINEMENT_TOLERANCE_SECONDS=1.0

# Periodic Background Screening Interval (Minutes)
BACKGROUND_SCREENING_INTERVAL_MINUTES=5

# Cache & Storage
DATABASE_PATH=data/aegis_orbital.sqlite

# Frontend Settings (Vite prefix)
VITE_API_BASE_URL=http://localhost:8000
